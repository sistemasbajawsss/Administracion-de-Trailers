# Copia este archivo como .env.local y llena los valores reales.
# Nunca subas .env.local al repositorio.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Modo simulado (solo Sección 0A, mientras no hay proyecto de Supabase).
# 1 = usa el usuario de src/mock/ y no protege rutas. Se elimina en 0B.
USE_MOCK_AUTH=0
# Rol del usuario simulado: admin | capturista
MOCK_ROLE=admin
