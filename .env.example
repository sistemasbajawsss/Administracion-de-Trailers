# Copia este archivo como .env.local y llena los valores reales.
# Nunca subas .env.local al repositorio.

# Supabase (botón Connect o Project Settings → Data API / API Keys)
# Solo la publishable key. La secret / service_role key NUNCA va con prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor (gestión de usuarios). Supabase → Project Settings → API Keys → secret / service_role.
# Se salta RLS: nunca con prefijo NEXT_PUBLIC_, nunca en GitHub. En producción va en las variables de Vercel.
SUPABASE_SERVICE_ROLE_KEY=
